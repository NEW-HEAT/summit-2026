# Archive source is allowlisted. The production vault and private receipts never enter Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/RECOVERY.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/SOURCE_MANIFEST.json
!/SCREENSHOTS.json
!/VERIFY.json
!/opening/
!/rewind/
!/personal/
!/community/
!/closing/
!/timecode/
!/slides/
!/tools/
**/node_modules/
**/.dev/
**/.cache/
**/dist/
**/output/
**/outputs/
**/__pycache__/
**/*.pyc
**/.env*
**/*.mov
**/*.mp4
**/*.webm
**/*.m4a
**/*.mp3
**/*.ttf
**/*.log
**/private-inputs/
**/data/
**/reference-frames/
**/.history/
